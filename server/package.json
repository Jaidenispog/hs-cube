{
  "name": "onestack-api",
  "version": "0.1.0",
  "description": "OneStack backend — the API the OneStack mobile app talks to.",
  "private": true,
  "scripts": {
    "dev": "ts-node src/main.ts",
    "start": "ts-node src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start:prod": "node dist/main.js",
    "db:push": "prisma db push",
    "db:reset": "prisma db push --force-reset && ts-node prisma/seed.ts",
    "seed": "ts-node prisma/seed.ts",
    "setup": "prisma generate && prisma db push && ts-node prisma/seed.ts",
    "start:prod": "prisma db push --skip-generate && ts-node prisma/seed.ts && node dist/main.js",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.15",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
