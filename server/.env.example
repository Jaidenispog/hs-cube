# OneStack API — local config.
#
# SQLite database file (default: a local file you own). Swap to Postgres for deployment by changing the
# provider in prisma/schema.prisma and this URL, e.g. postgresql://user:pass@host:5432/onestack.
DATABASE_URL="file:./dev.db"

# Secret used to sign auth tokens. CHANGE THIS for anything but local dev.
JWT_SECRET="dev-only-change-me"

# Port the API listens on. The mobile app expects it under /api/v1 (see README).
PORT=3001

# Set to any value to enable /auth/dev-login and /auth/demo-credentials. Leave unset in production.
DEV_LOGIN_ENABLED=true
